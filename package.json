{
  "name": "asikvestel-bot",
  "version": "1.0.0",
  "description": "Standalone Discord bot and media vault tracker for Aşık Vestel",
  "main": "src/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/index.js",
    "test": "node --test tests/*.test.js",
    "lint:arch": "node scripts/lint-quality.mjs",
    "lint:harness": "bash scripts/lint-ecl.sh && bash scripts/lint-encoding.sh",
    "verify": "npm test && npm run lint:arch && npm run lint:harness",
    "deploy": "bash scripts/deploy.sh"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "discord.js": "^14.17.3",
    "dotenv": "^16.4.7"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
