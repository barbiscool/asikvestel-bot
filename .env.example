# ==========================================
# Aşık Vestel Standalone Discord Bot Config
# ==========================================

# Discord Bot Credentials
DISCORD_BOT_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_client_id_here

# Guilds (first DISCORD_GUILD_ID is the primary one)
DISCORD_GUILD_ID=1389232967271972914,1061058726137692332
AUTH_GUILD_ID=1389232967271972914
AV2_GUILD_ID=1061058726137692332

# Monitored Channels
CLIPS_CHANNEL_IDS=1508809916905685224,1389232968140062823
MEDIA_SCAN_CHANNEL_IDS=1508809916905685224,1389232968140062823,1210949927702757447,1072955073421901834

# Chat Bridge Channels
DISCORD_CHAT_CHANNEL_ID=1072955073421901834
CHAT_CHANNEL_ISTANBUL_ID=1072955073421901834
CHAT_CHANNEL_ANKARA_ID=1389232968140062823
# Where the bot relays Discord chat messages to the website, and the shared secret.
WEB_API_URL=http://127.0.0.1:4000
CHAT_BRIDGE_INTERNAL_SECRET=generate_a_long_random_string

# Database & Vault Storage (shared with the website; keys must match it exactly)
DB_PATH=/var/lib/asikvestel/clips.db
DB_ENCRYPTION_KEY=generate_64_hex_chars_here
VAULT_STORAGE_DIR=/var/www/data/vault_blobs
# Optional; defaults to DB_ENCRYPTION_KEY
# VAULT_ENCRYPTION_KEY=
MEDIA_DB_PATH=/var/lib/asikvestel/media.db

# Admin
NODE_ENV=production
ADMIN_DISCORD_USER_ID=735152588801966132
SITE_URL=https://asikvestel.org
